<mujoco model="RealMan RM65-B pneumatic polishing arm">
  <compiler angle="radian" meshdir="assets/rm65" autolimits="true"/>
  <option integrator="implicitfast"/>

  <!-- Kinematics, inertias, joint limits, torque limits and visual meshes are
       adapted from RealManRobot/rm_robot (Apache-2.0).  Collision shapes are
       deliberately simple primitives: the vendor STL files are visual meshes,
       while stable control/contact simulation benefits from convex primitives. -->
  <default>
    <joint armature="0.03" damping="0.6"/>
    <geom friction="0.7 0.01 0.0001"/>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2" rgba="0.82 0.84 0.90 1"/>
    </default>
    <default class="collision">
      <geom group="3" rgba="0.25 0.45 0.75 0.18"/>
    </default>
  </default>

  <asset>
    <mesh name="rm_base" file="base_link.STL"/>
    <mesh name="rm_link1" file="link1.STL"/>
    <mesh name="rm_link2" file="link2.STL"/>
    <mesh name="rm_link3" file="link3.STL"/>
    <mesh name="rm_link4" file="link4.STL"/>
    <mesh name="rm_link5" file="link5.STL"/>
    <mesh name="rm_link6" file="link6.STL"/>
  </asset>

  <worldbody>
    <!-- Right-side floor pedestal.  This placement and zero-yaw mounting let one
         continuous, collision-free elbow branch cover the complete 0.36 m part. -->
    <body name="base_link" pos="0.78 0 0.30" quat="1 0 0 0">
      <inertial mass="0.8410708" pos="-0.0004333 -0.0000355 0.0599428"
                fullinertia="0.00172611 0.00170987 0.00090402 0.00000253 -0.00003677 0.00000168"/>
      <geom mesh="rm_base" class="visual"/>
      <geom type="cylinder" size="0.09 0.075" pos="0 0 0.075" class="collision"/>

      <body name="Link1" pos="0 0 0.2405">
        <joint name="joint1" axis="0 0 1" range="-3.1 3.1"/>
        <inertial mass="0.5935634" pos="0 0.021108 -0.0251854"
                  fullinertia="0.00126614 0.00118168 0.00056135 -0.00000001 -0.00000001 -0.00021122"/>
        <geom mesh="rm_link1" class="visual"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.10" size="0.055" class="collision"/>

        <body name="Link2" euler="1.5708 -1.5708 0">
          <joint name="joint2" axis="0 0 1" range="-2.268 2.268"/>
          <inertial mass="0.8641750" pos="0.152256 0 -0.006203"
                    fullinertia="0.00089150 0.00733754 0.00697869 -0.00000002 0.00156246 0.00000001"/>
          <geom mesh="rm_link2" class="visual"/>
          <geom type="capsule" fromto="0 0 0 0.256 0 0" size="0.045" class="collision"/>

          <body name="Link3" pos="0.256 0 0" euler="0 0 1.5708">
            <joint name="joint3" axis="0 0 1" range="-2.355 2.355"/>
            <inertial mass="0.2896337" pos="0 -0.059593 0.010569"
                      fullinertia="0.00063737 0.00015648 0.00061418 -0.00000007 -0.00000004 -0.00014461"/>
            <geom mesh="rm_link3" class="visual"/>
            <!-- Tight proxy matching the vendor Link3 STL bounds; the earlier
                 21 cm / 42 mm capsule extended beyond the mesh and falsely hit
                 the workpiece while the visible link was still clear. -->
            <geom type="capsule" fromto="0 0 0 0 -0.15 0" size="0.030" class="collision"/>

            <body name="Link4" pos="0 -0.21 0" euler="1.5708 0 0">
              <joint name="joint4" axis="0 0 1" range="-3.1 3.1"/>
              <inertial mass="0.2394198" pos="0 -0.018042 -0.021539"
                        fullinertia="0.00028594 0.00026273 0.00011989 0 0 0.00004424"/>
              <geom mesh="rm_link4" class="visual"/>
              <geom type="capsule" fromto="0 0 0 0 0 -0.08" size="0.026" class="collision"/>

              <body name="Link5" euler="-1.5708 0 0">
                <joint name="joint5" axis="0 0 1" range="-2.233 2.233"/>
                <inertial mass="0.2187998" pos="0 -0.059381 0.007368"
                          fullinertia="0.00035054 0.00010493 0.00033448 -0.00000003 -0.00000002 -0.00007824"/>
                <geom mesh="rm_link5" class="visual"/>
                <geom type="capsule" fromto="0 0 0 0 -0.115 0" size="0.027" class="collision"/>

                <body name="Link6" pos="0 -0.144 0" euler="1.5708 0 0">
                  <joint name="joint6" axis="0 0 1" range="-6.28 6.28"/>
                  <inertial mass="0.0649018" pos="0.000714 -0.000397 -0.012672"
                            fullinertia="0.00002028 0.00001880 0.00003179 -0.00000133 -0.00000003 0"/>
                  <geom mesh="rm_link6" class="visual"/>
                  <geom type="cylinder" size="0.035 0.045" pos="0 0 -0.025" class="collision"/>

                  <!-- The vendor Link6 mesh lies behind the z=0 flange plane
                       (mesh bounds z=-0.029..0). The physical tool therefore
                       mounts outward along Link6 +Z, not on the -Z joint side. -->
                  <geom name="tool_flange_adapter" type="cylinder"
                        size="0.018 0.006" pos="0 0 0.006"
                        rgba="0.45 0.47 0.50 1" contype="0" conaffinity="0"/>

                  <!-- Equivalent pneumatic orbital-sander model. The slide is the
                       real tool's axial compliance; positive tool-z points toward
                       the workpiece. Spring/damper terms model the floating head,
                       while pneumatic_force represents regulator/cylinder thrust. -->
                  <body name="pneumatic_tool_mount" pos="0 0 0.012">
                    <geom type="cylinder" size="0.025 0.014" pos="0 0 0.014"
                          rgba="0.20 0.20 0.22 1" contype="0" conaffinity="0"/>
                    <body name="pneumatic_slide" pos="0 0 0.025">
                      <joint name="tool_compliance" type="slide" axis="0 0 1"
                             range="-0.008 0.012" stiffness="1200" damping="55"
                             springref="0" armature="0.05"/>
                      <inertial mass="0.24" pos="0 0 0.015" diaginertia="0.00018 0.00018 0.00012"/>
                      <geom type="cylinder" size="0.020 0.015" pos="0 0 0.015"
                            rgba="0.18 0.18 0.20 1" contype="0" conaffinity="0"/>
                      <!-- Full-size visual backing pad plus a small central contact
                           proxy. This represents a soft pad without asking MuJoCo to
                           solve dozens of simultaneous rigid rim contacts. -->
                      <geom name="pad_visual" type="cylinder" size="0.025 0.006"
                            pos="0 0 0.034" rgba="0.92 0.55 0.12 1"
                            contype="0" conaffinity="0"/>
                      <geom name="pad_geom" type="sphere" size="0.008"
                            pos="0 0 0.034" rgba="0.92 0.55 0.12 0.15"
                            contype="2" conaffinity="2" friction="0.9 0.02 0.001"
                            solref="0.012 1" solimp="0.9 0.95 0.001"/>
                      <site name="tcp_site" pos="0 0 0.028" size="0.006" rgba="1 0 0 1"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="actuator1" joint="joint1" ctrlrange="-60 60"/>
    <motor name="actuator2" joint="joint2" ctrlrange="-60 60"/>
    <motor name="actuator3" joint="joint3" ctrlrange="-30 30"/>
    <motor name="actuator4" joint="joint4" ctrlrange="-10 10"/>
    <motor name="actuator5" joint="joint5" ctrlrange="-10 10"/>
    <motor name="actuator6" joint="joint6" ctrlrange="-10 10"/>
    <motor name="pneumatic_force" joint="tool_compliance" ctrlrange="0 20"/>
  </actuator>

  <keyframe>
    <!-- Numerical IK solution: TCP above the first raster point, tool normal down. -->
    <key name="home" qpos="-1.212272797 0.106864358 -0.101170519 -0.000003673 -1.576490166 0.720000000 0"
         ctrl="0 0 0 0 0 0 4"/>
  </keyframe>

  <contact>
    <exclude body1="base_link" body2="Link1"/>
    <exclude body1="Link1" body2="Link2"/>
    <exclude body1="Link2" body2="Link3"/>
    <exclude body1="Link3" body2="Link4"/>
    <!-- Conservative capsule proxies overlap across this folded elbow even
         though the vendor visual meshes do not. Exclude that false pair. -->
    <exclude body1="Link3" body2="Link5"/>
    <exclude body1="Link4" body2="Link5"/>
    <exclude body1="Link5" body2="Link6"/>
  </contact>
</mujoco>
